{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2023"],
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": false,
        "types": ["node", "vitest/globals", "@discordjs/builders"],
        "composite": true,
        "incremental": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "data",
        "tests/mocks",
        "src/handlers"
    ],
    "references": [
        { "path": "./tsconfig.core.json" },
        { "path": "./tsconfig.config.json" },
        { "path": "./tsconfig.db.json" },
        { "path": "./tsconfig.gateway.json" },
        { "path": "./tsconfig.i18n.json" },
        { "path": "./tsconfig.observability.json" },
        { "path": "./tsconfig.types.json" },
        { "path": "./tsconfig.generated.json" },
        { "path": "./tsconfig.utils.json" },
        { "path": "./tsconfig.cli.json" },
        { "path": "./tsconfig.queue.json" },
        { "path": "./tsconfig.plugins.json" },
        { "path": "./tsconfig.admin.json" }
    ]
}