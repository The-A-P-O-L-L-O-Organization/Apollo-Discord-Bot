# Apollo Discord Bot v2 — Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────

# Discord Bot Token
# Get from: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your-discord-bot-token-here

# Discord Client ID (Application ID)
# Get from: https://discord.com/developers/applications → General Information
CLIENT_ID=your-client-id-here

# Bot owner Discord user ID(s) — required for /interlink, /plugin, /system, /queue, /migrate, global blacklist
# Comma-separated for multiple owners: OWNER_IDS=111,222,333
OWNER_IDS=your-discord-user-id

# Encryption key for sensitive data storage (REQUIRED for production)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Operator agreement — MUST be set to literal 'true' after reading legal/TOS.md and legal/PRIVACY.md
OPERATOR_AGREEMENT=false

# Contact information published via /operator-contact
# Examples: "Discord: @yourname#0001", "email: you@example.com", "Support server: https://discord.gg/your-invite"
OPERATOR_CONTACT=

# ── Core Runtime ──────────────────────────────────────────────────────

# Node environment
# NODE_ENV=production

# Unique pod identifier (defaults to 'default' or hostname)
# POD_ID=my-bot

# Guild ID for testing commands (instant updates in one server)
# Leave unset for production (global commands, up to 1h propagation)
# GUILD_ID=your-guild-id-here

# Run mode: 'gateway' (default, WebSocket connection) or 'worker' (job processing)
# RUN_MODE=gateway

# ── Database ──────────────────────────────────────────────────────────

# Database type: 'sqlite' (default) or 'postgres'
# DB_TYPE=sqlite

# PostgreSQL connection (required when DB_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@host:5432/apollo
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ── Redis / Queue (BullMQ) ────────────────────────────────────────────

# Enable work queue (requires Redis)
# QUEUE_ENABLED=true

# Redis connection
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Queue settings
# QUEUE_PREFIX=apollo
# QUEUE_STALLED_INTERVAL=30000

# ── Interlink (Cross-Bot Communication) ───────────────────────────────

# Enable the interlink plugin
# INTERLINK_ENABLED=true

# HTTP server for receiving messages from external bots
# INTERLINK_HTTP_PORT=3456
# INTERLINK_BIND_HOST=127.0.0.1

# Rate limiting for inbound HTTP
# INTERLINK_RATE_LIMIT=60
# INTERLINK_RATE_WINDOW_MS=60000

# Redis for interlink (defaults to queue Redis if unset)
# INTERLINK_REDIS_HOST=localhost
# INTERLINK_REDIS_PORT=6379
# INTERLINK_REDIS_PASSWORD=your-redis-password
# INTERLINK_REDIS_PREFIX=apollo:interlink

# Event forwarding
# INTERLINK_FORWARD_EVENTS=memberJoin,guildBanAdd

# Outbound HTTP settings
# INTERLINK_REQUEST_TIMEOUT=5000
# INTERLINK_MAX_RETRIES=3

# ── Integrations (Twitch, YouTube, GitHub, RSS) ───────────────────────

# Port for incoming webhooks from GitHub, etc.
# INTEGRATIONS_WEBHOOK_PORT=8080

# GitHub webhook secret for verification
# GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Twitch API credentials
# TWITCH_CLIENT_ID=your-twitch-client-id
# TWITCH_CLIENT_SECRET=your-twitch-client-secret

# YouTube Data API key
# YOUTUBE_API_KEY=your-youtube-api-key

# Poll intervals in ms (default: 5 min for Twitch/YouTube, 15 min for RSS)
# INTEGRATIONS_POLL_TWITCH=300000
# INTEGRATIONS_POLL_YOUTUBE=300000
# INTEGRATIONS_POLL_RSS=900000

# ── Translation (LibreTranslate) ──────────────────────────────────────

# LibreTranslate API base URL (optional, defaults to public instance)
# TRANSLATION_API_BASE_URL=https://translate.argosopentech.com

# API key if required by your instance (most public instances don't need one)
# TRANSLATION_API_KEY=your-api-key-here

# ── AI Moderation (OpenAI) ────────────────────────────────────────────

# OpenAI API key for AI-powered content moderation (free endpoint)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key

# ── CLI Tool ──────────────────────────────────────────────────────────

# Guild ID for CLI operations (apollo-cli)
# APOLLO_GUILD_ID=your-guild-id

# Unix socket for admin RPC (default: ./data/apollo.sock)
# APOLLO_SOCKET_PATH=/tmp/apollo.sock

# Auth token for socket connections (recommended for production)
# APOLLO_SOCKET_TOKEN=your-secure-random-token

# ── Security / Auditing ───────────────────────────────────────────────

# Security log retention in days (default: 90)
# SECURITY_LOG_RETENTION_DAYS=90

# Allow unverified plugins (development only — DISABLE IN PRODUCTION)
# ALLOW_UNVERIFIED_PLUGINS=0

# Log sampling rate (0.0 to 1.0, default: 1.0 = no sampling)
# Set to 0.1 for 10% sampling in high-volume production
# LOG_SAMPLE_RATE=1.0

# ── Plugin Worker Sandbox ─────────────────────────────────────────────

# Plugin directory for worker processes (default: ./src/plugins)
# PLUGIN_DIR=./src/plugins