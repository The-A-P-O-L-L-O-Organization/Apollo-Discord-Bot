# Apollo Discord Bot v2 — Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────

# Discord Bot Token
# Get from: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your-discord-bot-token-here

# Discord Client ID (Application ID)
# Get from: https://discord.com/developers/applications → General Information
CLIENT_ID=your-client-id-here

# Bot owner Discord user ID(s) — required for /plugin, /system, /queue, /migrate
# Comma-separated for multiple owners: OWNER_IDS=111,222
OWNER_IDS=your-discord-user-id

# ── Optional — Single Instance (default) ──────────────────────────────

# Database type: 'sqlite' (default) or 'postgres'
# DB_TYPE=sqlite

# Node environment
# NODE_ENV=production

# Unique pod identifier (defaults to 'default')
# POD_ID=my-bot

# Guild ID for testing commands (instant updates in one server)
# Leave unset for production (global commands, up to 1h propagation)
# GUILD_ID=your-guild-id-here

# ── Optional — Multi-Instance (PostgreSQL) ────────────────────────────

# Enable PostgreSQL (requires DATABASE_URL)
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@host:5432/apollo
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ── Optional — Multi-Instance (BullMQ Queue) ──────────────────────────

# Enable work queue (requires Redis)
# QUEUE_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# QUEUE_PREFIX=apollo
# QUEUE_STALLED_INTERVAL=30000

# Run mode: 'gateway' (default, WebSocket connection) or 'worker' (job processing)
# RUN_MODE=gateway

# ── Optional — Translation (DeepL) ────────────────────────────────────

# DeepL API key for the /translate command
# Get from: https://www.deepl.com/pro-api
# DEEPL_API_KEY=your-deepl-api-key-here

# ── Optional — Nova Plugin ───────────────────────────────────────────

# Channel ID where daily Na'vi words are posted
# NAVI_CHANNEL_ID=your-channel-id-here
