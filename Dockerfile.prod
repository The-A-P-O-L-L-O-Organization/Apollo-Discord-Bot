# syntax=docker/dockerfile:1.4
# Production Dockerfile for Apollo Discord Bot
# Optimized multi-stage build with BuildKit cache mounts

# Stage 1: Build stage
FROM node:26.7.0-alpine AS builder

# Install build dependencies for better-sqlite3
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Install pnpm via corepack
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@11 --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./

# Install dependencies with BuildKit cache mount (production only)
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline --prod

# Copy source code
COPY src ./src
COPY bin ./bin
COPY deploy-commands.js ./
COPY plugin-manifest.json ./

# Stage 2: Production stage (minimal)
FROM node:26.7.0-alpine

# Install runtime dependencies only
RUN apk add --no-cache libstdc++

WORKDIR /app

ENV NODE_ENV=production

# Install pnpm via corepack (needed for `pnpm start` command)
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@11 --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./

# Copy built artifacts from builder stage
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/src ./src
COPY --from=builder /app/deploy-commands.js ./
COPY --from=builder /app/plugin-manifest.json ./

# Create directories for persistent data
RUN mkdir -p /app/src/data /app/logs /app/data/plugins && \
    ln -s /app/bin/apollo.js /usr/local/bin/apollo

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs && \
    chown -R nodejs:nodejs /app

USER nodejs

# Health check - hits real /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:9090/health', (r) => { if (r.statusCode !== 200) process.exit(1) }).on('error', () => process.exit(1))" || exit 1

CMD ["pnpm", "start"]