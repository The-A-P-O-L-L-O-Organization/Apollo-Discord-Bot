# syntax=docker/dockerfile:1.4
# Production Dockerfile for Apollo Discord Bot (TypeScript)
# Multi-stage build: compile TS to dist/ in builder, ship dist/ only in runtime.

# Stage 1: Build stage
FROM node:26.7.0-alpine AS builder

# Install build dependencies for better-sqlite3 native bindings
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Install pnpm via corepack
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@11 --activate

# Copy package files first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* .npmrc* ./

# Install ALL dependencies (dev deps required for tsc + esbuild)
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prefer-offline

# Copy TypeScript configs and source
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY bin ./bin
COPY scripts/generate-manifest.mjs ./scripts/generate-manifest.mjs
COPY plugin-manifest.json ./

# Compile gateway/worker/shard entries to dist/ with source maps
RUN pnpm build

# Bundle CLI entry to a single file
RUN pnpm build:cli

# Regenerate plugin-manifest.json from current sources
RUN pnpm manifest

# Stage 2: Production stage (minimal)
FROM node:26.7.0-alpine

# Install runtime dependencies only
RUN apk add --no-cache libstdc++

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS=--enable-source-maps

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* .npmrc* ./

# Copy production node_modules from builder (native bindings built for alpine)
COPY --from=builder /app/node_modules ./node_modules

# Copy compiled output, CLI bundle, and regenerated manifest
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/plugin-manifest.json ./

# Create directories for persistent data
RUN mkdir -p /app/src/data /app/logs /app/data/plugins && \
    ln -s /app/dist/bin/apollo.js /usr/local/bin/apollo

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 -G nodejs && \
    chown -R nodejs:nodejs /app

USER nodejs

# Health check - hits real /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:9090/health', (r) => { if (r.statusCode !== 200) process.exit(1) }).on('error', () => process.exit(1))" || exit 1

CMD ["node", "dist/index.js"]
