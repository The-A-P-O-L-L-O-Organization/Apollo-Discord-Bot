# Production Dockerfile for Apollo Discord Bot
# Optimized for minimal size and maximum performance

# Use multi-stage build for smaller final image
# Stage 1: Build stage
FROM node:26-alpine AS builder

# Install build dependencies for better-sqlite3
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Set environment variables for pnpm
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# Install pnpm
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./

# Install dependencies (postinstall rebuilds better-sqlite3)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY src ./src
COPY bin ./bin
COPY deploy-commands.js ./

# Stage 2: Production stage
FROM node:26-alpine

# Install runtime dependencies
RUN apk add --no-cache libstdc++

WORKDIR /app

# Set environment variables
ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# Install pnpm
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./

# Copy from builder stage
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/src ./src
COPY --from=builder /app/deploy-commands.js ./
COPY data ./data

# Create directories for persistent data
RUN mkdir -p /app/bot /app/logs /app/data/plugins && \
    ln -s /app/bin/apollo.js /usr/local/bin/apollo

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
  adduser -S nodejs -u 1001 -G nodejs && \
  chown -R nodejs:nodejs /app

USER nodejs

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "process.exit(0)" || exit 1

CMD ["pnpm", "start"]

