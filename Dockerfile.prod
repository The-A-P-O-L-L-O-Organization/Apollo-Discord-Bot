# Production Dockerfile for Apollo Discord Bot
# Optimized for minimal size and maximum performance

# Use multi-stage build for smaller final image
# Stage 1: Build stage
FROM node:24.14-alpine3.23 AS builder

# Install build dependencies for better-sqlite3
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install && \
    cd node_modules/better-sqlite3 && \
    npm run build-release

# Copy source code
COPY src ./src
COPY deploy-commands.js ./

# Stage 2: Production stage
FROM node:24.14-alpine3.23

# Install runtime dependencies
RUN apk add --no-cache libstdc++

WORKDIR /app

# Set environment variables
ENV NODE_ENV=production

# Copy from builder stage
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/src ./src
COPY --from=builder /app/deploy-commands.js ./

# Create directories for persistent data
RUN mkdir -p /app/bot /app/logs

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
  adduser -S nodejs -u 1001 -G nodejs && \
  chown -R nodejs:nodejs /app

USER nodejs

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "process.exit(0)" || exit 1

CMD ["npm", "start"]
