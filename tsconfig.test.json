{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node", "vitest/globals", "@discordjs/builders", "@types/node"]
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "bin/**/*",
        "scripts/**/*"
    ],
    "exclude": [
        "src/handlers/**",
        "node_modules"
    ]
}