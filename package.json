{
  "name": "@apollo/bot",
  "version": "3.0.0",
  "description": "Modular Discord bot with plugin system, multi-instance HA, and Redis-backed queue architecture",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "apollo": "./dist/bin/apollo.js"
  },
  "type": "module",
  "scripts": {
    "apollo": "node dist/bin/apollo.js",
    "start": "node dist/index.js",
    "start:gateway": "RUN_MODE=gateway node dist/index.js",
    "start:worker": "RUN_MODE=worker node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:gateway": "RUN_MODE=gateway tsx watch src/index.ts",
    "dev:worker": "RUN_MODE=worker tsx watch src/index.ts",
    "dev:shard": "tsx src/shard.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:cli": "esbuild bin/apollo.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bin/apollo.js",
    "build:test": "tsc -p tsconfig.test.json",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "proto:generate": "buf generate",
    "proto:generate:go": "buf generate --template buf.gen.go.yaml --path protos/interlink",
    "proto:generate:ts": "buf generate --template buf.gen.ts.yaml --path protos/interlink",
    "proto:lint": "buf lint",
    "proto:breaking": "buf breaking --against '.git#branch=main'",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint src/**/*.ts --fix",
    "lint:locales": "node scripts/lint-locales.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "manifest": "node scripts/generate-manifest.mjs"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.3",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@noble/hashes": "^2.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-grpc": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "buffer": "^6.0.3",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "^2.6.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "msgpackr": "^2.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@eslint/js": "^10.0.1",
    "@testcontainers/redis": "^12.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.2",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "i18next-cli": "^1.74.1",
    "madge": "^8.0.0",
    "supertest": "^7.3.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}