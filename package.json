{
  "name": "@apollo/bot",
  "version": "2.0.0",
  "description": "Modular Discord bot with plugin system, multi-instance HA, and Redis-backed queue architecture",
  "main": "dist/index.js",
  "bin": {
    "apollo": "./dist/bin/apollo.js"
  },
  "type": "module",
  "scripts": {
    "apollo": "node dist/bin/apollo.js",
    "start": "node dist/index.js",
    "start:gateway": "RUN_MODE=gateway node dist/index.js",
    "start:worker": "RUN_MODE=worker node dist/index.js",
    "dev": "node --watch src/index.js",
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.ts tests/**/*.ts bin/**/*.ts scripts/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts bin/**/*.ts scripts/**/*.ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "manifest": "tsx scripts/generate-manifest.ts"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "buffer": "^6.0.3",
    "bullmq": "^6.2.2",
    "compression": "^1.8.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "msgpackr": "^2.1.0",
    "nsfwjs": "^4.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-plugin-vitest": "^0.5.4",
    "madge": "^8.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}