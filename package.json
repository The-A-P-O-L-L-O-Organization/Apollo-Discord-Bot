{
  "name": "@apollo/bot",
  "version": "1.0.0",
  "description": "Apollo Discord bot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node deploy-commands.js",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@conversationai/perspectiveapi-js-client": "^1.0.1",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.0",
    "nsfwjs": "^4.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "glob": "11.1.0",
      "cross-spawn": "7.0.5",
      "axios": "^1.9.0",
      "tar": "^7.5.11"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "vitest": "^4.1.2"
  }
}
