{
  "name": "@apollo/bot",
  "version": "1.0.0",
  "description": "Apollo Discord bot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "start:gateway": "RUN_MODE=gateway node src/index.js",
    "start:worker": "RUN_MODE=worker node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node deploy-commands.js",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@conversationai/perspectiveapi-js-client": "^1.0.1",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.76.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "knex": "^3.2.10",
    "nsfwjs": "^4.3.0",
    "pg": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "vitest": "^4.1.5"
  }
}
