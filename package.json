{
  "name": "@apollo/bot",
  "version": "2.0.0",
  "description": "Modular Discord bot with plugin system, multi-instance HA, and Redis-backed queue architecture",
  "main": "dist/index.js",
  "bin": {
    "apollo": "./dist/bin/apollo.js"
  },
  "type": "module",
  "scripts": {
    "apollo": "node dist/bin/apollo.js",
    "start": "node dist/index.js",
    "start:gateway": "RUN_MODE=gateway node dist/index.js",
    "start:worker": "RUN_MODE=worker node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:gateway": "RUN_MODE=gateway tsx watch src/index.ts",
    "dev:worker": "RUN_MODE=worker tsx watch src/index.ts",
    "dev:shard": "tsx src/shard.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:cli": "esbuild bin/apollo.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bin/apollo.js",
    "build:test": "tsc -p tsconfig.test.json",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "manifest": "node scripts/generate-manifest.mjs"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "buffer": "^6.0.3",
    "bullmq": "^6.3.6",
    "compression": "^1.8.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "msgpackr": "^2.1.0",
    "nsfwjs": "^4.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "madge": "^8.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}