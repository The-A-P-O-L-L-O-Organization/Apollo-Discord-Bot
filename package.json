{
  "name": "@apollo/bot",
  "version": "2.0.0",
  "description": "Modular Discord bot with plugin system, multi-instance HA, and Redis-backed queue architecture",
  "main": "src/index.js",
  "bin": {
    "apollo": "./bin/apollo.js"
  },
  "type": "module",
  "scripts": {
    "apollo": "node bin/apollo.js",
    "start": "node src/index.js",
    "start:gateway": "RUN_MODE=gateway node src/index.js",
    "start:worker": "RUN_MODE=worker node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node deploy-commands.js",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "manifest": "node scripts/generate-manifest.mjs"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "buffer": "^6.0.3",
    "bullmq": "^5.79.3",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "knex": "^3.3.0",
    "nsfwjs": "^4.3.0",
    "pg": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@tensorflow/tfjs-node",
      "core-js",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.6.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
