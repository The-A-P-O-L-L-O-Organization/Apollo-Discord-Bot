{
  "name": "@apollo/bot",
  "version": "2.0.0",
  "description": "Modular Discord bot with plugin system, multi-instance HA, and Redis-backed queue architecture",
  "main": "src/index.js",
  "bin": {
    "apollo": "./bin/apollo.js"
  },
  "type": "module",
  "scripts": {
    "apollo": "node bin/apollo.js",
    "start": "node src/index.js",
    "start:gateway": "RUN_MODE=gateway node src/index.js",
    "start:worker": "RUN_MODE=worker node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy:commands": "node scripts/deploy-commands.js",
    "postinstall": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.js tests/**/*.js",
    "lint:fix": "eslint src/**/*.js tests/**/*.js --fix",
    "manifest": "node scripts/generate-manifest.mjs"
  },
  "author": "CodeMaster013",
  "license": "GPLv3",
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordjs/rest": "^2.6.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "buffer": "^6.0.3",
    "bullmq": "^6.2.2",
    "compression": "^1.8.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "nsfwjs": "^4.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "adm-zip": "^0.6.0"
  }
}
