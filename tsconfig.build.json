{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "incremental": true,
        "tsBuildInfoFile": "./.cache/tsbuildinfo/app.tsbuildinfo"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "tests/**",
        "tests/**/*",
        "src/handlers/**",
        "src/generated/nsfw/nsfw/v1/nsfw.ts"
    ]
}